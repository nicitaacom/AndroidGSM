<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:orientation="vertical"
              android:background="@color/bg_dark">

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/bg_elevated"
            android:padding="32dp"
            android:elevation="4dp">

        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GSM Gateway"
                android:textSize="28sp"
                android:textColor="@color/brand_green"
                android:textStyle="bold"
                android:layout_gravity="center"
                android:letterSpacing="0.08" />

        <TextView
                android:id="@+id/statusTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Status: Ready"
                android:textSize="14sp"
                android:textColor="@color/text_primary"
                android:layout_gravity="center"
                android:layout_marginTop="16dp"
                android:padding="10dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:background="@color/bg_card"
                android:textAllCaps="true"
                android:letterSpacing="0.05" />
    </LinearLayout>

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

        <Button
                android:id="@+id/toggleButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="START SERVICE"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:background="@color/brand_green"
                android:elevation="8dp"
                android:letterSpacing="0.1"
                android:stateListAnimator="@null"
                android:layout_marginBottom="8dp" />

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

            <Button
                    android:id="@+id/testAudioButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="56dp"
                    android:text="TEST AUDIO"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:background="@color/brand_green"
                    android:elevation="8dp"
                    android:stateListAnimator="@null"
                    android:layout_marginEnd="4dp" />
            
            <Button
                    android:id="@+id/defaultDialerButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="56dp"
                    android:text="SET DIALER"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:background="@color/brand_green"
                    android:elevation="8dp"
                    android:stateListAnimator="@null"
                    android:layout_marginStart="4dp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
            android:id="@+id/sim_selection_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:background="@color/bg_card"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            android:elevation="2dp"
            android:visibility="gone">

        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select SIM for Calls"
                android:textSize="16sp"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

        <RadioGroup
                android:id="@+id/sim_radio_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="16dp" />
    </LinearLayout>

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:layout_marginBottom="12dp">

        <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="ACTIVITY LOGS"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/text_secondary"
                android:letterSpacing="0.15" />

        <Button
                android:id="@+id/copyLogsButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="COPY LAST 50"
                android:textSize="10sp"
                android:textColor="@color/black"
                android:background="@color/brand_green"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:stateListAnimator="@null" />
    </LinearLayout>

    <ScrollView
            android:id="@+id/scrollView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/bg_card"
            android:padding="20dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            android:elevation="2dp">

        <TextView
                android:id="@+id/logTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Waiting for logs...\n"
                android:textSize="12sp"
                android:textColor="@color/text_primary"
                android:fontFamily="monospace"
                android:lineSpacingExtra="6dp" />
    </ScrollView>

    <TextView
            android:id="@+id/versionTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="outreach-tool.com | v.25-12-22-1"
            android:textSize="11sp"
            android:textColor="#ffffff"
            android:fontFamily="monospace"
            android:gravity="center"
            android:paddingTop="12dp"
            android:paddingBottom="16dp" />

</LinearLayout>
