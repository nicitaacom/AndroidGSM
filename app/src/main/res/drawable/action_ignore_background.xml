<?xml version="1.0" encoding="utf-8"?>
<!-- [Ignore] on an incoming ring: the same translucent gray as the mute / loudspeaker toggles - no red, nothing ends for the caller. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="@color/toggle_pressed" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/toggle_idle" />
        </shape>
    </item>
</selector>
